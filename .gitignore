# Артефакты сборки Rust/tauri — это гигабайты, в репозиторий им нельзя.
/src-tauri/target/

# Готовые установщики и архивы (GitHub не принимает файлы больше 100 МБ).
*.zip
*.msi
*.exe
!/src-tauri/engine/bin/winws.exe

# Логи движка: перезаписываются при каждом подключении и содержат
# абсолютные пути пользователя.
*.log

# Резервная копия ipset — дубликат ipset-all.txt, приложению не нужна.
*.backup

# Отчёты и диагностика, которые генерируются локально.
/check-engine.txt
*.stale

# Мусор от инструментов и редакторов.
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
